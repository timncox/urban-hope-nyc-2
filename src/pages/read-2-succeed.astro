---
import Base from "../layouts/Base.astro";
---
<Base title="Read 2 Succeed" pageSlug="/read-2-succeed">

  <!-- ══ HERO ══ -->
  <section class="r2s-hero">
    <span class="r2s-eyebrow">Flagship Program · Eighth Year</span>
    <h1 class="r2s-h1">Read 2 Succeed</h1>
    <p class="r2s-standfirst">One adult, one child, one hour a week, for a school year — teaching a five- to seven-year-old on Staten Island's North Shore to read.</p>
    <div class="r2s-hero-actions">
      <a class="r2s-btn-primary" href="#">Fund a school</a>
      <a class="r2s-btn-outline" href="#">Become a tutor</a>
    </div>
  </section>

  <!-- ══ FACT STRIP ══ -->
  <section class="r2s-strip">
    <div class="r2s-strip-inner">
      <div class="r2s-fact">
        <span class="r2s-fact-fig">K–2</span>
        <span class="r2s-fact-cap">grades served</span>
      </div>
      <div class="r2s-fact">
        <span class="r2s-fact-fig">178</span>
        <span class="r2s-fact-cap">children, 2024–25</span>
      </div>
      <div class="r2s-fact">
        <span class="r2s-fact-fig">8</span>
        <span class="r2s-fact-cap">partner schools</span>
      </div>
      <div class="r2s-fact">
        <span class="r2s-fact-fig">1 hr</span>
        <span class="r2s-fact-cap">per week, per child</span>
      </div>
      <div class="r2s-fact">
        <span class="r2s-fact-fig">Jan–Jun</span>
        <span class="r2s-fact-cap">inside the school day</span>
      </div>
      <div class="r2s-fact">
        <span class="r2s-fact-fig">97%</span>
        <span class="r2s-fact-cap">finished the year</span>
      </div>
    </div>
  </section>

  <!-- ══ HOW IT WORKS ══ -->
  <section class="r2s-how">
    <span class="r2s-section-label">How it works</span>
    <h2 class="r2s-how-h2">The whole model fits in a sentence.</h2>
    <p class="r2s-how-intro">A trained volunteer walks into a public school during the school day and sits with the same child every week until June. There is no transport problem, no attendance problem, and no new building to run.</p>
    <div class="r2s-steps">
      <div class="r2s-step">
        <span class="r2s-step-num">01</span>
        <div class="r2s-step-body">
          <h3 class="r2s-step-title">The school selects the child</h3>
          <p class="r2s-step-text">Classroom teachers identify the K–2 students furthest behind in reading. We do not cherry-pick.</p>
        </div>
      </div>
      <div class="r2s-step">
        <span class="r2s-step-num">02</span>
        <div class="r2s-step-body">
          <h3 class="r2s-step-title">We train and clear the volunteer</h3>
          <p class="r2s-step-text">No teaching background required. Training and books provided. Fingerprinting, background check and DOE visitor clearance completed before a volunteer meets a child.</p>
        </div>
      </div>
      <div class="r2s-step">
        <span class="r2s-step-num">03</span>
        <div class="r2s-step-body">
          <h3 class="r2s-step-title">One hour a week, January to June</h3>
          <p class="r2s-step-text">Reading aloud, phonics and vocabulary, at lunch or after the bell. Same pairing all year.</p>
        </div>
      </div>
      <div class="r2s-step">
        <span class="r2s-step-num">04</span>
        <div class="r2s-step-body">
          <h3 class="r2s-step-title">The child can stay in our world</h3>
          <p class="r2s-step-text">HopeKidz after school, Summer Streets in July, Ambassadors of Peace in middle school, a paid summer job at sixteen.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ WHERE IT RUNS ══ -->
  <section class="r2s-schools">
    <span class="r2s-section-label">Where it runs</span>
    <h2 class="r2s-schools-h2">Eight schools, named.</h2>
    <div class="r2s-schools-grid">
      <div class="r2s-school-card">
        <span class="r2s-school-name">Lavelle Preparatory Charter</span>
        <span class="r2s-school-hood">Charter</span>
      </div>
      <div class="r2s-school-card">
        <span class="r2s-school-name">PS 16</span>
        <span class="r2s-school-hood">Tompkinsville</span>
      </div>
      <div class="r2s-school-card">
        <span class="r2s-school-name">PS 18</span>
        <span class="r2s-school-hood">West Brighton</span>
      </div>
      <div class="r2s-school-card">
        <span class="r2s-school-name">PS 31</span>
        <span class="r2s-school-hood">New Brighton</span>
      </div>
      <div class="r2s-school-card">
        <span class="r2s-school-name">PS 44</span>
        <span class="r2s-school-hood">Mariners Harbor</span>
      </div>
      <div class="r2s-school-card">
        <span class="r2s-school-name">PS 57</span>
        <span class="r2s-school-hood">Clifton</span>
      </div>
      <div class="r2s-school-card">
        <span class="r2s-school-name">PS 68</span>
        <span class="r2s-school-hood">Port Richmond</span>
      </div>
      <div class="r2s-school-card">
        <span class="r2s-school-name">PS 78</span>
        <span class="r2s-school-hood">Stapleton</span>
      </div>
    </div>
    <span class="r2s-red-note">[ Neighborhood labels to verify ]</span>
  </section>

  <!-- ══ WHAT WE MEASURE ══ -->
  <section class="r2s-measure">
    <span class="r2s-section-label r2s-section-label-muted">What we measure</span>
    <h2 class="r2s-measure-h2">Attendance and retention, honestly. Reading growth, not yet.</h2>
    <p class="r2s-measure-body">178 children started and 173 finished. That number comes off a school enrollment roll and anyone can audit it. Reading gain is a different story — our own reporting has mixed two incompatible scales, so we will not put a growth number on a grant application until someone independent has checked it.</p>
    <div class="r2s-status-rows">
      <div class="r2s-status-row">
        <span class="r2s-status-metric">Children enrolled</span>
        <span class="r2s-status-badge r2s-status-green">Counted</span>
      </div>
      <div class="r2s-status-row">
        <span class="r2s-status-metric">Sessions delivered</span>
        <span class="r2s-status-badge r2s-status-green">Counted</span>
      </div>
      <div class="r2s-status-row">
        <span class="r2s-status-metric">Year-end retention</span>
        <span class="r2s-status-badge r2s-status-green">Counted</span>
      </div>
      <div class="r2s-status-row">
        <span class="r2s-status-metric">Reading level pre/post</span>
        <span class="r2s-status-badge r2s-status-amber">Being Rebuilt</span>
      </div>
      <div class="r2s-status-row">
        <span class="r2s-status-metric">Comparison group</span>
        <span class="r2s-status-badge r2s-status-red">None</span>
      </div>
      <div class="r2s-status-row">
        <span class="r2s-status-metric">External evaluation</span>
        <span class="r2s-status-badge r2s-status-red">Never Done</span>
      </div>
    </div>
  </section>

  <!-- ══ WHAT IT COSTS ══ -->
  <section class="r2s-costs">
    <span class="r2s-section-label">What it costs</span>
    <h2 class="r2s-costs-h2">What one child costs, and what a school costs.</h2>
    <div class="r2s-cost-cards">
      <div class="r2s-cost-card">
        <span class="r2s-cost-figure">$&thinsp;[&thinsp;&thinsp;&thinsp;]</span>
        <span class="r2s-cost-label">Per child, per year</span>
      </div>
      <div class="r2s-cost-card">
        <span class="r2s-cost-figure">$&thinsp;[&thinsp;&thinsp;&thinsp;]</span>
        <span class="r2s-cost-label">To adopt one school</span>
      </div>
    </div>
    <div class="r2s-cost-note">
      <p class="r2s-cost-note-body">Urban Hope publishes no cost-per-child anywhere today, and we are not going to invent one for a draft. These are the highest-value numbers missing from the current site.</p>
    </div>
  </section>

  <!-- ══ CLOSING PANELS ══ -->
  <section class="r2s-closing">
    <div class="r2s-closing-panel r2s-closing-amber">
      <span class="r2s-closing-eyebrow">For foundations</span>
      <h2 class="r2s-closing-h2">Fund a school for a year.</h2>
      <p class="r2s-closing-body">Cover every child in a single building — name a school, track the numbers, come and watch a session. No form, no gate.</p>
      <a class="r2s-btn-dark" href="#">Request the funder packet</a>
    </div>
    <div class="r2s-closing-panel r2s-closing-navy">
      <span class="r2s-closing-eyebrow">For volunteers</span>
      <h2 class="r2s-closing-h2">One hour a week, January to June.</h2>
      <p class="r2s-closing-body">No teaching background required. Training, books, fingerprinting and DOE clearance all handled before you meet a child.</p>
      <a class="r2s-btn-amber" href="#">Apply to volunteer</a>
    </div>
  </section>

</Base>

<style>
/* ══════════════════════════════════════
   READ 2 SUCCEED PAGE
══════════════════════════════════════ */

/* ── Hero ── */
.r2s-hero {
  padding: 3.5rem 0 3.5rem;
  border-bottom: 1px solid var(--rule);
  margin-bottom: 0;
}
.r2s-eyebrow {
  font-family: var(--mono);
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--amber);
  display: block;
  margin-bottom: 1.1rem;
}
.r2s-h1 {
  font-family: var(--serif);
  font-weight: 300;
  font-style: italic;
  font-size: clamp(3.6rem, 10vw, 7rem);
  letter-spacing: -0.035em;
  line-height: 1.0;
  color: var(--navy);
  margin: 0 0 1.5rem;
  animation: fadeUp 0.65s ease both;
}
.r2s-standfirst {
  font-family: var(--sans);
  font-size: 1.1rem;
  font-weight: 300;
  line-height: 1.75;
  color: var(--ink);
  max-width: 58ch;
  margin: 0 0 2.25rem;
  animation: fadeUp 0.65s 0.12s ease both;
}
.r2s-hero-actions {
  display: flex;
  gap: 0.85rem;
  flex-wrap: wrap;
  animation: fadeUp 0.65s 0.22s ease both;
}
.r2s-btn-primary {
  font-family: var(--mono);
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: var(--amber);
  color: var(--ink);
  border: 2px solid var(--amber);
  padding: 0.65rem 1.35rem;
  text-decoration: none;
  display: inline-block;
  transition: background 0.18s, color 0.18s;
}
.r2s-btn-primary:hover {
  background: #d4912a;
  border-color: #d4912a;
  color: var(--ink);
  text-decoration: none;
}
.r2s-btn-outline {
  font-family: var(--mono);
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: transparent;
  color: var(--navy);
  border: 2px solid var(--navy);
  padding: 0.65rem 1.35rem;
  text-decoration: none;
  display: inline-block;
  transition: background 0.18s, color 0.18s;
}
.r2s-btn-outline:hover {
  background: var(--navy);
  color: var(--paper);
  text-decoration: none;
}

/* ── Fact strip ── */
.r2s-strip {
  background: var(--ink);
  margin: 0 -2rem;
  padding: 3.5rem 2rem;
  border-top: 4px solid var(--amber);
}
.r2s-strip-inner {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 1.5rem 1rem;
}
@media (max-width: 860px) {
  .r2s-strip-inner { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 500px) {
  .r2s-strip-inner { grid-template-columns: repeat(2, 1fr); }
}
.r2s-fact {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
  padding-right: 1rem;
  border-right: 1px solid #1E3A4A;
}
.r2s-strip-inner .r2s-fact:last-child {
  border-right: none;
}
.r2s-fact-fig {
  font-family: var(--serif);
  font-size: clamp(1.9rem, 4vw, 2.9rem);
  font-weight: 300;
  font-style: italic;
  line-height: 1;
  color: var(--amber);
  display: block;
}
.r2s-fact-cap {
  font-family: var(--sans);
  font-size: 0.8rem;
  font-weight: 300;
  line-height: 1.4;
  color: #8AAAB8;
  display: block;
  max-width: 18ch;
}

/* ── Section label ── */
.r2s-section-label {
  font-family: var(--mono);
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--amber);
  display: block;
  margin-bottom: 2rem;
}
.r2s-section-label-muted {
  color: #6B7E8A;
}

/* ── How it works ── */
.r2s-how {
  background: var(--paper);
  margin: 0 -2rem;
  padding: 4.5rem 2rem 5rem;
  border-top: 1px solid var(--rule);
}
.r2s-how-h2 {
  font-family: var(--serif);
  font-size: clamp(1.9rem, 4vw, 2.9rem);
  font-weight: 300;
  font-style: italic;
  color: var(--navy);
  letter-spacing: -0.025em;
  line-height: 1.15;
  margin: 0 0 1.25rem;
  animation: none;
}
.r2s-how-intro {
  font-family: var(--sans);
  font-size: 1rem;
  font-weight: 300;
  line-height: 1.75;
  color: var(--ink);
  max-width: 62ch;
  margin: 0 0 3.5rem;
}
.r2s-steps {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  border: 1.5px solid var(--rule);
}
@media (max-width: 620px) {
  .r2s-steps { grid-template-columns: 1fr; }
}
.r2s-step {
  display: flex;
  gap: 1.5rem;
  align-items: flex-start;
  padding: 2rem 2rem 1.75rem;
  border-right: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
  background: #ffffff;
}
.r2s-steps .r2s-step:nth-child(2n) { border-right: none; }
.r2s-steps .r2s-step:nth-child(3),
.r2s-steps .r2s-step:nth-child(4) { border-bottom: none; }
@media (max-width: 620px) {
  .r2s-step { border-right: none !important; }
  .r2s-steps .r2s-step:last-child { border-bottom: none; }
  .r2s-steps .r2s-step:nth-child(3) { border-bottom: 1px solid var(--rule); }
}
.r2s-step-num {
  font-family: var(--serif);
  font-size: 2.8rem;
  font-weight: 300;
  line-height: 1;
  color: var(--amber);
  flex-shrink: 0;
  margin-top: -0.1em;
}
.r2s-step-title {
  font-family: var(--sans);
  font-size: 0.92rem;
  font-weight: 500;
  color: var(--navy);
  letter-spacing: 0.01em;
  line-height: 1.3;
  margin: 0 0 0.65rem;
}
.r2s-step-text {
  font-family: var(--sans);
  font-size: 0.88rem;
  font-weight: 300;
  line-height: 1.65;
  color: var(--ink);
  margin: 0;
}

/* ── Where it runs ── */
.r2s-schools {
  background: var(--card);
  margin: 0 -2rem;
  padding: 4.5rem 2rem 5rem;
  border-top: 1px solid #D4CBB8;
  border-bottom: 1px solid #D4CBB8;
}
.r2s-schools-h2 {
  font-family: var(--serif);
  font-size: clamp(1.9rem, 4vw, 2.9rem);
  font-weight: 300;
  font-style: italic;
  color: var(--navy);
  letter-spacing: -0.025em;
  line-height: 1.15;
  margin: 0 0 2.5rem;
  animation: none;
}
.r2s-schools-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin-bottom: 1.75rem;
}
@media (max-width: 720px) {
  .r2s-schools-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 400px) {
  .r2s-schools-grid { grid-template-columns: 1fr; }
}
.r2s-school-card {
  border: 1.5px solid #D4CBB8;
  padding: 1.35rem 1.2rem 1.1rem;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}
.r2s-school-name {
  font-family: var(--serif);
  font-size: 1.05rem;
  font-weight: 400;
  font-style: italic;
  color: var(--navy);
  letter-spacing: -0.01em;
  line-height: 1.25;
  display: block;
}
.r2s-school-hood {
  font-family: var(--mono);
  font-size: 0.6rem;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
  display: block;
}
.r2s-red-note {
  font-family: var(--mono);
  font-size: 0.65rem;
  font-weight: 400;
  letter-spacing: 0.05em;
  color: #c0392b;
  line-height: 1.6;
  display: block;
  margin-top: 0.5rem;
}

/* ── What we measure ── */
.r2s-measure {
  background: var(--navy);
  margin: 0 -2rem;
  padding: 4.5rem 2rem 5rem;
  border-top: 4px solid var(--amber);
}
.r2s-measure-h2 {
  font-family: var(--serif);
  font-size: clamp(1.75rem, 3.5vw, 2.7rem);
  font-weight: 300;
  font-style: italic;
  color: #F0F6FA;
  letter-spacing: -0.025em;
  line-height: 1.15;
  margin: 0 0 1.5rem;
  max-width: 32ch;
  animation: none;
}
.r2s-measure-body {
  font-family: var(--sans);
  font-size: 1rem;
  font-weight: 300;
  line-height: 1.75;
  color: #B8CDD9;
  max-width: 64ch;
  margin: 0 0 3rem;
}
.r2s-status-rows {
  border: 1px solid #1E5070;
  background: rgba(255,255,255,0.03);
  max-width: 56ch;
}
.r2s-status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1.5rem;
  padding: 0.85rem 1.25rem;
  border-bottom: 1px solid #1E5070;
}
.r2s-status-row:last-child { border-bottom: none; }
.r2s-status-metric {
  font-family: var(--sans);
  font-size: 0.92rem;
  font-weight: 300;
  color: #D0E4EE;
}
.r2s-status-badge {
  font-family: var(--mono);
  font-size: 0.6rem;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 0.22rem 0.6rem;
  border-radius: 2px;
  white-space: nowrap;
  flex-shrink: 0;
}
.r2s-status-green {
  color: #1E7D4A;
  background: #E6F6ED;
}
.r2s-status-amber {
  color: #8B5A00;
  background: #FFF3CD;
}
.r2s-status-red {
  color: #9B1A0A;
  background: #FDEDEC;
}

/* ── What it costs ── */
.r2s-costs {
  background: var(--paper);
  margin: 0 -2rem;
  padding: 4.5rem 2rem 5rem;
  border-top: 1px solid var(--rule);
}
.r2s-costs-h2 {
  font-family: var(--serif);
  font-size: clamp(1.9rem, 4vw, 2.9rem);
  font-weight: 300;
  font-style: italic;
  color: var(--navy);
  letter-spacing: -0.025em;
  line-height: 1.15;
  margin: 0 0 2.5rem;
  animation: none;
}
.r2s-cost-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
  margin-bottom: 1.75rem;
}
@media (max-width: 520px) {
  .r2s-cost-cards { grid-template-columns: 1fr; }
}
.r2s-cost-card {
  border: 1.5px solid var(--rule);
  padding: 2.5rem 2rem 2rem;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.r2s-cost-figure {
  font-family: var(--serif);
  font-size: clamp(2.6rem, 6vw, 4rem);
  font-weight: 300;
  line-height: 1;
  color: #c0392b;
  display: block;
  letter-spacing: -0.02em;
}
.r2s-cost-label {
  font-family: var(--mono);
  font-size: 0.65rem;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted);
  display: block;
}
.r2s-cost-note {
  background: var(--ink);
  padding: 2rem 2rem 1.75rem;
  border: none;
}
.r2s-cost-note-body {
  font-family: var(--sans);
  font-size: 0.95rem;
  font-weight: 300;
  line-height: 1.7;
  color: #8AAAB8;
  margin: 0;
  max-width: 68ch;
}

/* ── Closing panels ── */
.r2s-closing {
  display: grid;
  grid-template-columns: 1fr 1fr;
  margin: 0 -2rem;
  border-top: 4px solid var(--amber);
}
@media (max-width: 640px) {
  .r2s-closing { grid-template-columns: 1fr; }
}
.r2s-closing-panel {
  padding: 4rem 2.5rem 4.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  align-items: flex-start;
}
.r2s-closing-amber {
  background: var(--amber);
}
.r2s-closing-navy {
  background: var(--navy);
}
.r2s-closing-eyebrow {
  font-family: var(--mono);
  font-size: 0.62rem;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
