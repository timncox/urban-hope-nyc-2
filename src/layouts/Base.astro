---
import { site, getNonHomePages } from "../site";
import { validateDesign } from "../design";

interface Props {
  title: string;
  description?: string;
  pageSlug: string;
}

const { title, description, pageSlug } = Astro.props;
const pageDescription = description ?? site.site.description;
const fullTitle = pageSlug === "/" ? `${site.site.name} — ${site.site.tagline}` : `${title} · ${site.site.name}`;
const canonicalUrl = site.site.url ? new URL(pageSlug, site.site.url).toString() : pageSlug;

const fontStack: Record<string, string> = {
  sans: 'system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif',
  serif: 'Georgia, "Times New Roman", "Iowan Old Style", serif',
  mono: 'ui-monospace, "SF Mono", Menlo, Monaco, "Cascadia Code", "Roboto Mono", monospace',
};

// Optional rich design block. Validated/sanitized at build time; falls back to the
// legacy theme look when absent or malformed — legacy sites are never disturbed.
const design = validateDesign(site.design);
const legacyDark = { bg: "#0b0b0b", fg: "#f4f4f4", muted: "#999999", border: "#222222" };

const baseFont = fontStack[site.theme.font] ?? fontStack.sans;
const light = design?.palette.light ?? {
  bg: "#ffffff", fg: "#111111", accent: site.theme.accent, muted: "#666666", border: "#e5e5e5",
};
const dark = design?.palette.dark ?? { ...legacyDark, accent: light.accent };
const fontDisplay = design ? `"${design.fonts.display.family}", ${baseFont}` : baseFont;
const fontBody = design ? `"${design.fonts.body.family}", ${baseFont}` : baseFont;

const cssVars = {
  accent: light.accent,
  fontDisplay,
  fontBody,
  bgLight: light.bg, fgLight: light.fg, mutedLight: light.muted, borderLight: light.border,
  bgDark: dark.bg, fgDark: dark.fg, mutedDark: dark.muted, borderDark: dark.border,
};

const fontLinks = design
  ? [design.fonts.display.import, design.fonts.body.import].filter((u): u is string => !!u)
  : [];

const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": site.schema?.type ?? "WebSite",
  name: site.site.name,
  description: site.site.description,
  ...(site.site.url ? { url: site.site.url } : {}),
  ...(site.schema?.extra ?? {}),
};

const navPages = getNonHomePages();
---
<!doctype html>
<html lang="en" data-theme={site.theme.mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.site.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <link rel="alternate" type="application/json" href="/api/site.json" title={`${site.site.name} content (machine-readable)`} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-friendly site guide" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {fontLinks.length > 0 && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        {fontLinks.map((href) => <link rel="stylesheet" href={href} />)}
      </>
    )}

    <style is:global define:vars={cssVars}>
      :root {
        --accent: var(--accent);
        --font-display: var(--fontDisplay);
        --font-body: var(--fontBody);
        --bg: var(--bgLight);
        --fg: var(--fgLight);
        --muted: var(--mutedLight);
        --border: var(--borderLight);
        --radius: 6px;
        --content-max: 1240px;
        --content-pad: 2.5rem;
      }
      :root[data-theme="dark"] {
        --bg: var(--bgDark);
        --fg: var(--fgDark);
        --muted: var(--mutedDark);
        --border: var(--borderDark);
      }
      @media (prefers-color-scheme: dark) {
        :root[data-theme="auto"] {
          --bg: var(--bgDark);
          --fg: var(--fgDark);
          --muted: var(--mutedDark);
          --border: var(--borderDark);
        }
      }

      @media (max-width: 700px) {
        :root {
          --content-pad: 1.25rem;
        }
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: var(--font-body);
        background: var(--bg);
        color: var(--fg);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .container { max-width: var(--content-max); margin: 0 auto; padding: 0 var(--content-pad); }

      .draft-notice {
        background: #0F212D;
        color: #E8A33D;
        font-size: 12px;
        text-align: center;
        letter-spacing: 0.1em;
        padding: 10px 1rem;
        width: 100%;
      }

      /* ── Site header: full-bleed navy band ── */
      .site-header-outer {
        background: #14405E;
        border-bottom: 3px solid #E8A33D;
        width: 100%;
        /* amber notch strip above */
        border-top: 4px solid transparent;
        background-image:
          repeating-linear-gradient(90deg, #E8A33D 0, #E8A33D 8px, transparent 8px, transparent 14px);
        background-size: 100% 4px;
        background-repeat: no-repeat;
        background-position: top;
        padding-top: 4px;
      }

      .site-header-inner {
        max-width: var(--content-max);
        margin: 0 auto;
        padding: 0.85rem var(--content-pad);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
      }

      .site-brand-link {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none !important;
        color: inherit;
        flex-shrink: 0;
      }
      .site-brand-link:hover { text-decoration: none !important; }

      .site-brand-logo {
        flex-shrink: 0;
        display: block;
      }

      .site-brand-name {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.05rem;
        /* force paper colour regardless of any design CSS specificity */
        color: #F7F2E9 !important;
        line-height: 1.15;
        letter-spacing: -0.01em;
        white-space: nowrap;
      }

      .site-header-nav {
        display: flex;
        gap: 1.25rem;
        flex-wrap: wrap;
        align-items: center;
      }

      .site-header-nav a {
        /* override design CSS which sets nav a color */
        color: #B7C9D4 !important;
        font-size: 0.88rem;
        text-decoration: none;
        transition: color 0.18s;
        white-space: nowrap;
      }
      .site-header-nav a:hover,
      .site-header-nav a[aria-current="page"] {
        color: #E8A33D !important;
        text-decoration: none;
      }

      @media (max-width: 390px) {
        .site-header-inner {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.75rem;
          padding: 0.85rem 1rem;
        }
        .site-brand-name { white-space: normal; }
        .site-header-nav { gap: 0.9rem; }
      }

      /* ── Legacy header.site rules (kept for backwards compat, nulled for our new header) ── */
      header.site {
        display: none;
      }

      main h1, main h2, main h3 { font-family: var(--font-display); }
      main h1 { font-size: 2.2rem; line-height: 1.15; margin: 0 0 0.5rem; letter-spacing: -0.01em; }
      main h2 { font-size: 1.5rem; margin: 2rem 0 0.5rem; letter-spacing: -0.01em; }
      main h3 { font-size: 1.15rem; margin: 1.5rem 0 0.4rem; }
      main p { margin: 0.85rem 0; }
      main ul, main ol { padding-left: 1.4rem; }
      main img { max-width: 100%; height: auto; border-radius: var(--radius); }
      main blockquote { border-left: 3px solid var(--accent); margin: 1rem 0; padding: 0.25rem 0 0.25rem 1rem; color: var(--muted); }
      main code { background: var(--border); padding: 0.1rem 0.3rem; border-radius: 3px; font-size: 0.9em; }
      main pre { background: var(--border); padding: 1rem; border-radius: var(--radius); overflow-x: auto; }
      main pre code { background: transparent; padding: 0; }
      main hr { border: 0; border-top: 1px solid var(--border); margin: 2rem 0; }

      .tagline { color: var(--muted); font-size: 1.1rem; margin: 0 0 2rem; }

      footer.site {
        width: 100vw;
        max-width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        margin-top: 0;
        padding: 0;
      }
      .footer-inner {
        max-width: var(--content-max);
        margin: 0 auto;
        padding: 3rem var(--content-pad);
        border-top: none;
        color: inherit;
        font-size: inherit;
        display: block;
        justify-content: unset;
        gap: unset;
        flex-wrap: unset;
      }
    </style>

    {design && <style is:global set:html={design.css}></style>}
  </head>
  <body>
    <div class="draft-notice">Concept redesign — draft for discussion.</div>

    <!-- Full-bleed navy header, sits outside .container -->
    <div class="site-header-outer">
      <div class="site-header-inner">
        <a class="site-brand-link" href="/">
          <!-- Open-book / roof logomark -->
          <svg
            class="site-brand-logo"
            width="30"
            height="30"
            viewBox="0 0 48 48"
            fill="none"
            stroke="#E8A33D"
            stroke-width="2.6"
            stroke-linejoin="round"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path d="M24 7 L5.5 17.5 L5.5 39 L24 30.5 Z" />
            <path d="M24 7 L42.5 17.5 L42.5 39 L24 30.5 Z" />
            <path d="M24 7 L24 30.5" />
          </svg>
          <span class="site-brand-name">{site.site.name}</span>
        </a>

        {navPages.length > 0 && (
          <nav class="site-header-nav">
            {navPages.map((p) => (
              <a href={p.slug}>{p.title}</a>
            ))}
          </nav>
        )}
      </div>
    </div>

    <div class="container">
      <main>
        <slot />
      </main>

      <footer class="site">
        <div class="footer-inner">
          <span class="footer-tagline">No sheep without a shepherd.</span>
          <p class="footer-address">77 Alaska Street, Staten Island, NY 10310</p>
          <p class="footer-inbox">[ Shared inbox to be set up ]</p>
          <p class="footer-bottom">© 2026 Urban Hope Inc. · 501(c)(3) · EIN 27-4637480</p>
        </div>
      </footer>
    </div>
  </body>
</html>
